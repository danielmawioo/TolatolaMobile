# Tolatola Mobile — copy to .env and set values (or export in shell / use EAS env).
#
# There are two var namings here for the same values: app.config.js reads the
# non-prefixed vars (APP_API_URL, SUPABASE_URL, ...) and passes them through
# Expo's `extra` config block — that's the real runtime path for the built app.
# src/config/env.ts falls back to the EXPO_PUBLIC_* vars only when
# Constants.expoConfig?.extra isn't available (e.g. running under Jest).
# Keep both sets in sync.

# Backend API base URL (no trailing slash). Use your machine IP for device/emulator (e.g. http://192.168.1.x:8080).
APP_API_URL=https://api.tolatola.co
EXPO_PUBLIC_APP_API_URL=https://api.tolatola.co

# Same Supabase project as TolatolaAPI. This is a publishable anon key (safe to
# commit — protected by Supabase Row Level Security, not a secret).
SUPABASE_URL=https://eyvumcctadmjetvjujcn.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV5dnVtY2N0YWRtamV0dmp1amNuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTkzODg0NzYsImV4cCI6MjA3NDk2NDQ3Nn0.RuFpE0tm1xGRHDZzreE1zpgWfNeGrsqxaXPRqvNXavs
EXPO_PUBLIC_SUPABASE_URL=https://eyvumcctadmjetvjujcn.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV5dnVtY2N0YWRtamV0dmp1amNuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTkzODg0NzYsImV4cCI6MjA3NDk2NDQ3Nn0.RuFpE0tm1xGRHDZzreE1zpgWfNeGrsqxaXPRqvNXavs

# Optional: app URL scheme for deep links
APP_URL=tolatolamobile://
EXPO_PUBLIC_APP_URL=tolatolamobile://

# Google OAuth Configuration (Enter your Google Cloud Console Client credentials)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-reversed-client-id

# Optional. When unset, error reporting stays local and Sentry is not initialized.
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
