import React, { useState } from 'react';
import {
  View,
  Text,
  ScrollView,
  Pressable,
  StyleSheet,
  TextInput,
  ActivityIndicator,
  Alert,
} from 'react-native';
import { router } from 'expo-router';
import { useSafeAreaInsets } from 'react-native-safe-area-context';
import FontAwesome from '@expo/vector-icons/FontAwesome';
import * as ImagePicker from 'expo-image-picker';
import { Theme } from '@/constants/Theme';
import { useAuth } from '@/src/contexts/AuthContext';
import { submitVendorRegistrationJson } from '@/src/api/onboardingSubmit';

type VendorKind = 'individual' | 'company';

export default function VendorRegisterScreen() {
  const insets = useSafeAreaInsets();
  const { session } = useAuth();
  const token = session?.access_token ?? '';
  const [kind, setKind] = useState<VendorKind>('individual');
  const [busy, setBusy] = useState(false);

  const [tin, setTin] = useState('');
  const [businessLicense, setBusinessLicense] = useState('');
  const [nida, setNida] = useState('');
  const [phone, setPhone] = useState('');
  const [email, setEmail] = useState('');
  const [taxClearance, setTaxClearance] = useState('');
  const [country, setCountry] = useState('Tanzania');
  const [region, setRegion] = useState('');
  const [district, setDistrict] = useState('');
  const [ward, setWard] = useState('');
  const [village, setVillage] = useState('');
  const [street, setStreet] = useState('');

  const [companyName, setCompanyName] = useState('');
  const [incorpCert, setIncorpCert] = useState('');
  const [repName, setRepName] = useState('');
  const [repEmail, setRepEmail] = useState('');
  const [repPhone, setRepPhone] = useState('');
  const [repPosition, setRepPosition] = useState('');

  const [licenseUri, setLicenseUri] = useState<string | null>(null);

  const pickDoc = async () => {
    const perm = await ImagePicker.requestMediaLibraryPermissionsAsync();
    if (!perm.granted) {
      Alert.alert('Permission', 'Photo library access is needed to attach license images.');
      return;
    }
    const res = await ImagePicker.launchImageLibraryAsync({
      mediaTypes: ImagePicker.MediaTypeOptions.Images,
      quality: 0.85,
    });
    if (!res.canceled && res.assets[0]?.uri) setLicenseUri(res.assets[0].uri);
  };

  const onSubmit = async () => {
    if (!token) {
      Alert.alert('Sign in required', 'Open this screen after signing in as a vendor.');
      return;
    }
    if (!tin.trim() || !businessLicense.trim() || !phone.trim() || !email.trim()) {
      Alert.alert('Missing fields', 'TIN, business license reference, phone and email are required.');
      return;
    }
    if (kind === 'individual' && !nida.trim()) {
      Alert.alert('Missing NIDA', 'Individual vendors must provide NIDA ID.');
      return;
    }
    if (kind === 'company' && (!companyName.trim() || !repName.trim())) {
      Alert.alert('Missing company details', 'Company name and representative name are required.');
      return;
    }
    setBusy(true);
    try {
      const payload: Record<string, unknown> = {
        vendor_type: kind,
        tin: tin.trim(),
        business_license: businessLicense.trim(),
        tax_clearance: taxClearance.trim(),
        phone: phone.trim(),
        email: email.trim().toLowerCase(),
        location: {
          country: country.trim(),
          region: region.trim(),
          district: district.trim(),
          ward: ward.trim(),
          village: village.trim(),
          street: street.trim(),
        },
        license_image_uri_note: licenseUri ? 'attached_on_client' : undefined,
      };
      if (kind === 'individual') {
        payload.nida = nida.trim();
      } else {
        payload.business_name = companyName.trim();
        payload.incorporation_certificate = incorpCert.trim();
        payload.representative = {
          full_name: repName.trim(),
          email: repEmail.trim().toLowerCase(),
          phone: repPhone.trim(),
          position: repPosition.trim(),
        };
      }
      await submitVendorRegistrationJson(token, payload);
      Alert.alert('Submitted', 'Your vendor KYC was sent for review.', [
        { text: 'OK', onPress: () => router.replace('/(vendor)/kyc-pending' as never) },
      ]);
    } catch (e) {
      Alert.alert('Could not submit', e instanceof Error ? e.message : 'Try again or use the web portal.');
    } finally {
      setBusy(false);
    }
  };

  return (
    <View style={[styles.root, { paddingTop: insets.top + 12 }]}>
      <Pressable style={styles.back} onPress={() => router.back()} hitSlop={12}>
        <FontAwesome name="chevron-left" size={18} color={Theme.link} />
        <Text style={styles.backText}>Back</Text>
      </Pressable>
      <ScrollView
        contentContainerStyle={[styles.scroll, { paddingBottom: 40 + insets.bottom }]}
        keyboardShouldPersistTaps="handled"
      >
        <Text style={styles.title}>Vendor registration</Text>
        <Text style={styles.body}>
          Provide the details required for verification (Phase 1 spec). Documents may also be completed on the web if
          the API is not yet configured for every field.
        </Text>

        <View style={styles.segment}>
          <Pressable style={[styles.segBtn, kind === 'individual' && styles.segBtnOn]} onPress={() => setKind('individual')}>
            <Text style={[styles.segTxt, kind === 'individual' && styles.segTxtOn]}>Individual</Text>
          </Pressable>
          <Pressable style={[styles.segBtn, kind === 'company' && styles.segBtnOn]} onPress={() => setKind('company')}>
            <Text style={[styles.segTxt, kind === 'company' && styles.segTxtOn]}>Company</Text>
          </Pressable>
        </View>

        <Field label="TIN number" value={tin} onChangeText={setTin} />
        <Field label="Business license (reference / number)" value={businessLicense} onChangeText={setBusinessLicense} />
        <Field label="Tax clearance (reference)" value={taxClearance} onChangeText={setTaxClearance} />
        <Field label="Phone" value={phone} onChangeText={setPhone} keyboardType="phone-pad" />
        <Field label="Email" value={email} onChangeText={setEmail} keyboardType="email-address" autoCapitalize="none" />

        {kind === 'individual' ? <Field label="NIDA ID" value={nida} onChangeText={setNida} /> : null}

        {kind === 'company' ? (
          <>
            <Field label="Incorporation certificate (ref)" value={incorpCert} onChangeText={setIncorpCert} />
            <Field label="Business name" value={companyName} onChangeText={setCompanyName} />
            <Text style={styles.subTitle}>Representative</Text>
            <Field label="Full name" value={repName} onChangeText={setRepName} />
            <Field label="Email" value={repEmail} onChangeText={setRepEmail} keyboardType="email-address" autoCapitalize="none" />
            <Field label="Phone" value={repPhone} onChangeText={setRepPhone} keyboardType="phone-pad" />
            <Field label="Position" value={repPosition} onChangeText={setRepPosition} />
          </>
        ) : null}

        <Text style={styles.subTitle}>Full location</Text>
        <Field label="Country" value={country} onChangeText={setCountry} />
        <Field label="Region" value={region} onChangeText={setRegion} />
        <Field label="District" value={district} onChangeText={setDistrict} />
        <Field label="Ward" value={ward} onChangeText={setWard} />
        <Field label="Village" value={village} onChangeText={setVillage} />
        <Field label="Street" value={street} onChangeText={setStreet} />

        <Pressable style={styles.attach} onPress={pickDoc}>
          <FontAwesome name="paperclip" size={18} color={Theme.primary} />
          <Text style={styles.attachText}>{licenseUri ? 'Business license image selected' : 'Attach business license image'}</Text>
        </Pressable>

        <Pressable style={[styles.primary, busy && { opacity: 0.7 }]} onPress={onSubmit} disabled={busy}>
          {busy ? <ActivityIndicator color="#fff" /> : <Text style={styles.primaryText}>Submit for review</Text>}
        </Pressable>

        <Pressable style={styles.secondary} onPress={() => router.replace('/(vendor)/shop/create')}>
          <Text style={styles.secondaryText}>Create shop listing instead</Text>
        </Pressable>
      </ScrollView>
    </View>
  );
}

function Field({
  label,
  value,
  onChangeText,
  keyboardType,
  autoCapitalize,
}: {
  label: string;
  value: string;
  onChangeText: (t: string) => void;
  keyboardType?: 'default' | 'email-address' | 'phone-pad';
  autoCapitalize?: 'none' | 'sentences';
}) {
  return (
    <View style={styles.field}>
      <Text style={styles.label}>{label}</Text>
      <TextInput
        style={styles.input}
        value={value}
        onChangeText={onChangeText}
        placeholderTextColor={Theme.textMuted}
        keyboardType={keyboardType}
        autoCapitalize={autoCapitalize ?? 'sentences'}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  root: { flex: 1, backgroundColor: Theme.backgroundSecondary, paddingHorizontal: 20 },
  scroll: { paddingBottom: 32 },
  back: { flexDirection: 'row', alignItems: 'center', gap: 6, marginBottom: 12 },
  backText: { fontSize: 16, color: Theme.link, fontWeight: '600' },
  title: { fontSize: 22, fontWeight: '700', color: Theme.text, marginBottom: 8 },
  body: { fontSize: 14, color: Theme.textSecondary, lineHeight: 20, marginBottom: 16 },
  subTitle: { fontSize: 16, fontWeight: '700', color: Theme.text, marginTop: 12, marginBottom: 8 },
  segment: { flexDirection: 'row', gap: 10, marginBottom: 16 },
  segBtn: {
    flex: 1,
    paddingVertical: 12,
    borderRadius: 10,
    borderWidth: 1,
    borderColor: Theme.inputBorder,
    alignItems: 'center',
    backgroundColor: Theme.background,
  },
  segBtnOn: { borderColor: Theme.primary, backgroundColor: 'rgba(37,99,235,0.08)' },
  segTxt: { fontWeight: '600', color: Theme.textSecondary },
  segTxtOn: { color: Theme.primary },
  field: { marginBottom: 12 },
  label: { fontSize: 13, fontWeight: '600', color: Theme.text, marginBottom: 4 },
  input: {
    borderWidth: 1,
    borderColor: Theme.inputBorder,
    borderRadius: 10,
    paddingHorizontal: 12,
    paddingVertical: 11,
    fontSize: 15,
    color: Theme.text,
    backgroundColor: Theme.background,
  },
  attach: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 10,
    paddingVertical: 14,
    marginBottom: 16,
  },
  attachText: { fontSize: 15, color: Theme.link, fontWeight: '600' },
  primary: {
    backgroundColor: Theme.primary,
    paddingVertical: 14,
    borderRadius: 12,
    alignItems: 'center',
    marginBottom: 12,
  },
  primaryText: { color: '#fff', fontSize: 16, fontWeight: '700' },
  secondary: { paddingVertical: 12, alignItems: 'center' },
  secondaryText: { color: Theme.link, fontSize: 15, fontWeight: '600' },
});
