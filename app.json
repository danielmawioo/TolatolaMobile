{
  "expo": {
    "name": "TOLA",
    "slug": "TolatolaMobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tola",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.tolatola.tola",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow TOLA to access your location to calculate accurate delivery fees and show nearby shops.",
        "NSCameraUsageDescription": "Allow TOLA to access your camera to take verification photos.",
        "NSPhotoLibraryUsageDescription": "Allow TOLA to access your photo library to select verification documents."
      }
    },
    "android": {
      "package": "co.tolata.tolamobile",
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBiaBqnElMfrziuV-9SLX2mbLIrA5WO754"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#6366f1",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TOLA to access your location to calculate accurate delivery fees and show nearby shops."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TOLA to access your photos to upload verification documents.",
          "cameraPermission": "Allow TOLA to access your camera to take verification photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
